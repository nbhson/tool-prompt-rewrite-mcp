# Universal Prompt Gate MCP Server - environment variables
# Copy to .env and adjust for your local setup.
#
# Precedence: real env (MCP client `env`/`environment`) > this .env > defaults.
# The server auto-loads .env (PROMPT_GATE_ENV_FILE -> CWD/.env -> repo/.env).

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Which provider implementation to use:
#   openai-compatible (default) - llama.cpp / any OpenAI-style endpoint
#   openai                    - same wire protocol, cloud baseUrl required
#   custom                    - load a module from PROMPT_GATE_CUSTOM_PROVIDER_MODULE
PROMPT_GATE_PROVIDER=openai-compatible
# Path to a local module that exports createCustomLLMProvider(cfg): LLMProvider.
# Only used when PROMPT_GATE_PROVIDER=custom. Lets you ship your own provider
# (e.g. a .env-driven local one) without editing this package.
# PROMPT_GATE_CUSTOM_PROVIDER_MODULE=/abs/path/to/my-provider.js

# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint (llama.cpp default)
# ---------------------------------------------------------------------------
# Endpoint LLM (OpenAI-compatible). Default points to local llama.cpp.
PROMPT_GATE_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Model name - verify against your llama.cpp version.
PROMPT_GATE_LLM_MODEL=qwen3.5-9b
# Local development key; not required to be real for local llama.cpp.
PROMPT_GATE_LLM_API_KEY=local-dev-key

# Optional: remote OpenAI-compatible endpoint (cloud or custom).
# When set, overrides PROMPT_GATE_LLM_BASE_URL.
# PROMPT_GATE_EXTERNAL_LLM=

# Timeout in ms for a single LLM request. Default 180s (thinking models
# like qwen3/3.5 on CPU can take 60-90s; raise if you run heavier models).
PROMPT_GATE_TIMEOUT_MS=180000
# Maximum retry count for LLM network errors (idempotent requests only).
PROMPT_GATE_LLM_RETRY_MAX=3
# Max completion tokens per request. Default 2048. Thinking models need
# headroom for reasoning before the final answer — too low (e.g. 1024)
# causes empty completions.
PROMPT_GATE_LLM_MAX_TOKENS=2048

# Thinking models (qwen3 / qwen3.5 via llama.cpp): set to "false" to skip
# the reasoning phase. llama.cpp respects `enable_thinking` / `thinking`
# in the request body when the model's chat template supports it.
# PROMPT_GATE_LLM_ENABLE_THINKING=false

# Pass-through extra JSON object merged into the LLM request body.
# PROMPT_GATE_LLM_EXTRA_JSON={"chat_format":"chatml"}

# ---------------------------------------------------------------------------
# Gate behavior when the client does not support MCP elicitation
# ---------------------------------------------------------------------------
# When the connected agent (e.g. an older VS Code / Cline / Continue) does
# not declare the `elicitation` capability, the gate tool cannot show an
# interactive picker. Two modes:
#   true  (default) - "echo fallback": the tool returns distinct
#         "pending_level_selection" / "pending_user_selection" results that
#         show the prompt versions in plain text with the numbered choices
#         (original / rewritten / update / cancel; "update" + `feedback`
#         rewrites again and returns a new menu). The agent asks the user and
#         re-calls the tool with `selection` (never auto-selects).
#   false - strict: the tool returns a hard compatibility error instead.
# PROMPT_GATE_ECHO_FALLBACK=true

# ---------------------------------------------------------------------------
# .env file location (advanced)
# ---------------------------------------------------------------------------
# Explicit path to a .env file. When unset, the server searches:
# CWD/.env then the .env next to build/index.js (the repo root).
# PROMPT_GATE_ENV_FILE=/abs/path/to/.env

# ---------------------------------------------------------------------------
# Transport & logging
# ---------------------------------------------------------------------------
# Transport: "stdio" (default for desktop agents) or "http".
PROMPT_GATE_TRANSPORT=stdio
# If transport=http, the HTTP port to listen on.
PROMPT_GATE_HTTP_PORT=3000

# Rewrite policy file (optional). Defaults to built-in meta-prompts
# (light/balanced/detailed) when unset.
# PROMPT_GATE_REWRITE_POLICY_FILE=./policies/default.md

# Logging level: "debug" | "info" | "warn" | "error".
# Full prompts are NEVER logged by design.
PROMPT_GATE_LOG_LEVEL=info
