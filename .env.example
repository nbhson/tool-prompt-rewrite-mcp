# Universal Prompt Gate MCP Server - environment variables
# Copy to .env and adjust for your local setup.

# LLM provider (OpenAI-compatible). Default points to local llama.cpp.
PROMPT_GATE_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Model name - verify against your llama.cpp version.
PROMPT_GATE_LLM_MODEL=qwen3.5-9b
# Local development key; not required to be real for local llama.cpp.
PROMPT_GATE_LLM_API_KEY=local-dev-key

# Optional: remote OpenAI-compatible endpoint (cloud or custom).
# PROMPT_GATE_EXTERNAL_LLM=

# Timeout in ms for a single LLM request. Default 180s (thinking models
# like qwen3/3.5 on CPU can take 60-90s; raise if you run heavier models).
PROMPT_GATE_TIMEOUT_MS=180000
# Maximum retry count for LLM network errors (idempotent requests only).
PROMPT_GATE_LLM_RETRY_MAX=3
# Max completion tokens per request. Default 2048. Thinking models need
# headroom for reasoning before the final answer — too low (e.g. 1024)
# causes empty completions.
PROMPT_GATE_LLM_MAX_TOKENS=2048

# Thinking models (qwen3 / qwen3.5 via llama.cpp): set to "false" to skip
# the reasoning phase. llama.cpp respects `enable_thinking` in the request
# body when the model's chat template supports it.
# PROMPT_GATE_LLM_ENABLE_THINKING=false

# Transport: "stdio" (default for desktop agents) or "http".
PROMPT_GATE_TRANSPORT=stdio
# If transport=http, the HTTP port to listen on.
PROMPT_GATE_HTTP_PORT=3000

# Rewrite policy file (optional). Defaults to built-in meta-prompts
# (light/balanced/detailed) when unset.
# PROMPT_GATE_REWRITE_POLICY_FILE=./policies/default.md

# Logging level: "debug" | "info" | "warn" | "error".
# Full prompts are NEVER logged by design.
PROMPT_GATE_LOG_LEVEL=info
