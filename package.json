{
  "name": "universal-prompt-gate-mcp",
  "version": "0.1.0",
  "description": "MCP server that gates prompts: rewrites, shows original/rewritten/cancel, and returns only the approved prompt.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "universal-prompt-gate-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "LICENSE",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prompt",
    "prompt-engineering",
    "rewrite",
    "gate",
    "llm",
    "llama-cpp",
    "elicitation",
    "claude",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbhson/tool-prompt-rewrite-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
